# Sem as duas variáveis públicas, as tools informam unavailable; a identidade
# institucional mínima continua disponível com fonte e data versionadas.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

HOST=0.0.0.0
PORT=3000
# Autoridades exatas: nome:porta para local; nome sem porta para HTTPS padrão.
# O hostname de RENDER_EXTERNAL_URL é permitido automaticamente no Render.
ALLOWED_HOSTS=
ALLOWED_ORIGINS=https://chatgpt.com,https://chat.openai.com

# Nunca configure chaves secret, service_role, JWTs ou sessões de usuário.
